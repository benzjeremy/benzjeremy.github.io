---

<Layout 
  titleDe="Projekte & Software-Katalog · Jeremy Benz"
  titleEn="Projects & Software Catalog · Jeremy Benz"
  currentPath="/status"
>
  <div class="container">
    <div class="page-intro">
      <p class="eyebrow">
        <span data-lang="de">Katalog & Übersicht</span>
        <span data-lang="en">Catalog & Overview</span>
      </p>
      <h1>
        <span data-lang="de">Alle Projekte im Überblick.</span>
        <span data-lang="en">All projects at a glance.</span>
      </h1>
      <p class="lead">
        <span data-lang="de">Eine strukturierte Übersicht aller im Ökosystem aktiven Programme, Webanwendungen und Repositories.</span>
        <span data-lang="en">A structured directory of all active software, web apps, and repositories in the ecosystem.</span>
      </p>
    </div>

    <div class="subpage-content">
      <!-- Toolbar with Search & Filter -->
      <div class="toolbar">
        <input 
          id="projectSearch" 
          type="search" 
          class="search-input" 
          placeholder="Projekt suchen / Search projects (z. B. Go, Docker, WebUntis)..." 
          aria-label="Search projects"
        />

        <div class="filter-group" role="group" aria-label="Category Filters">
          <button type="button" class="filter-btn active" data-filter="all">
            <span data-lang="de">Alle</span>
            <span data-lang="en">All</span>
          </button>
          <button type="button" class="filter-btn" data-filter="desktop">Desktop</button>
          <button type="button" class="filter-btn" data-filter="web">Web</button>
          <button type="button" class="filter-btn" data-filter="mobile">Android</button>
          <button type="button" class="filter-btn" data-filter="community">Community</button>
        </div>
      </div>

      <!-- Project Rows -->
      <div id="projectList" class="projects-list">
        {allProjects.map((p) => (
          <a 
            href={p.link} 
            class="project-row" 
            data-category={p.category}
            data-search={`${p.name} ${p.titleDe} ${p.titleEn} ${p.descDe} ${p.descEn}`.toLowerCase()}
          >
            <div class="project-icon">
              {p.icon ? (
                <img src={p.icon} alt={p.name} loading="lazy" />
              ) : (
                <span>{p.name.slice(0, 2).toUpperCase()}</span>
              )}
            </div>
            <div class="project-info">
              <h3>
                {p.name}
                <span aria-hidden="true">↗</span>
              </h3>
              <p data-lang="de">{p.descDe}</p>
              <p data-lang="en">{p.descEn}</p>
            </div>
            <span class="project-tag">{p.badge}</span>
          </a>
        ))}
      </div>

      <div id="noResults" style="display: none; padding: 48px; text-align: center; color: var(--text-muted);">
        <p data-lang="de">Keine Projekte für diesen Suchbegriff gefunden.</p>
        <p data-lang="en">No projects found matching your search query.</p>
      </div>
    </div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('projectSearch');
      const filterBtns = document.querySelectorAll('.filter-btn');
      const rows = document.querySelectorAll('.project-row');
      const noResults = document.getElementById('noResults');

      let currentFilter = 'all';
      let currentQuery = '';

      function filterProjects() {
        let visibleCount = 0;
        rows.forEach(row => {
          const cat = row.getAttribute('data-category');
          const text = row.getAttribute('data-search') || '';

          const matchesCat = currentFilter === 'all' || cat === currentFilter;
          const matchesQuery = !currentQuery || text.includes(currentQuery);

          if (matchesCat && matchesQuery) {
            row.style.display = 'grid';
            visibleCount++;
          } else {
            row.style.display = 'none';
          }
        });

        if (noResults) {
          noResults.style.display = visibleCount === 0 ? 'block' : 'none';
        }
      }

      searchInput?.addEventListener('input', (e) => {
        currentQuery = (e.target.value || '').trim().toLowerCase();
        filterProjects();
      });

      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          filterBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          currentFilter = btn.getAttribute('data-filter') || 'all';
          filterProjects();
        });
      });
    });
  </script>
</Layout>
