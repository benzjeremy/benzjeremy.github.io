---
import ProjectPage from '../../components/ProjectPage.astro';

const features = [
  {
    titleDe: 'Zero-Knowledge Ende-zu-Ende-Verschlüsselung',
    titleEn: 'Zero-Knowledge End-to-End Encryption',
    descDe: 'Dateiinhalte und Ordnernamen werden clientseitig mit AES-256-GCM verschlüsselt, bevor sie den Server erreichen. Der Serverbetreiber hat keinen Zugriff auf Klartext.',
    descEn: 'File contents and directory names are encrypted client-side with AES-256-GCM before upload. The server operator has zero access to unencrypted data.'
  },
  {
    titleDe: 'Schlanke Go-Architektur mit SQLite',
    titleEn: 'Lightweight Go Architecture with SQLite',
    descDe: 'Kompakt und ressourcensparend ohne ressourcenhungrige Java- oder PHP-Stacks. Läuft dauerhaft stabil mit unter 15 MB RAM auf dem Raspberry Pi 5.',
    descEn: 'Lean and efficient without bloated Java or PHP enterprise stacks. Operates rock-solid under 15 MB of RAM on the Raspberry Pi 5.'
  },
  {
    titleDe: 'Chunked Streaming & Integritäts-Hashes',
    titleEn: 'Chunked Streaming & Integrity Hashes',
    descDe: 'Große Dateien werden in verifizierbare Chunks unterteilt und mit SHA-256 Hashes geprüft. Resumable Uploads über unzuverlässige Verbindungen.',
    descEn: 'Large files are divided into verifiable chunks validated via SHA-256 hashes, supporting resilient resumable transfers.'
  },
  {
    titleDe: 'Nahtlose Tailscale-Mesh Integration',
    titleEn: 'Seamless Tailscale Mesh Integration',
    descDe: 'Sicherer Fernzugriff von unterwegs über verschlüsselte WireGuard-Tunnel ohne offene Router-Ports oder unsichere Portweiterleitungen.',
    descEn: 'Secure remote access on the go via encrypted WireGuard tunnels without exposing router ports or insecure forwarding.'
  }
];

const stats = [
  { val: 'AES-256', labelDe: 'Verschlüsselung', labelEn: 'Encryption' },
  { val: '100.000', labelDe: 'PBKDF2 Runden', labelEn: 'PBKDF2 iterations' },
  { val: '~14 MB', labelDe: 'Server-RAM', labelEn: 'Server memory' },
  { val: 'Zero-Knowledge', labelDe: 'Sicherheitsmodell', labelEn: 'Security model' }
];

const techPills = ['Go 1.22', 'AES-256-GCM', 'PBKDF2', 'SQLite', 'WebDAV', 'Tailscale', 'Linux'];
---

<ProjectPage
  id="benzcloud-server"
  name="benzcloud-server"
  version="v1.0"
  taglineDe="Autonome, datenschutzfreundliche Cloud-Suite in Go"
  taglineEn="Autonomous, privacy-first cloud suite in Go"
  summaryDe="Das dezentrale, selbst gehostete Speichersystem für maximale Datensouveränität. Entwickelt in modernem Go mit Zero-Knowledge-Verschlüsselung, geringstem Ressourcenverbrauch und Tailscale-Mesh-Anbindung."
  summaryEn="The decentralized, self-hosted cloud storage engine for ultimate data sovereignty. Built in modern Go with zero-knowledge encryption, minimal resource usage, and seamless Tailscale mesh integration."
  badge="Cloud & Server"
  icon="/assets/jb-logo.png"
  techPills={techPills}
  stats={stats}
  features={features}
  quickInstall={{ label: "Go Install", cmd: "go install pi5.darter-basking.ts.net/gitea/benzcloud-server/benzcloud-server@latest" }}
  wikiUrl="/benzcloud-server/wiki/"
/>
