---
import ProjectPage from '../../components/ProjectPage.astro';

const features = [
  {
    titleDe: 'Dynamisches VRAM-Routing & OOM-Schutz',
    titleEn: 'Dynamic VRAM Routing & OOM Protection',
    descDe: 'Überwacht den GPU- und Systemarbeitsspeicher in Echtzeit. Verhindert Kernel-OOM-Kills durch automatisches Auslagern inaktiver Modelle.',
    descEn: 'Monitors GPU and system memory allocations in real-time. Prevents system crash kills by gracefully unloading idle model weights.'
  },
  {
    titleDe: 'Multi-Node Lastverteilung über Tailscale',
    titleEn: 'Multi-Node Load Balancing via Tailscale',
    descDe: 'Verteilt Prompt-Anfragen dynamisch auf mehrere Rechenknoten im Mesh-Netzwerk (z. B. Pi 5, Desktop-PC mit dedizierter GPU).',
    descEn: 'Balances inference requests across multiple compute nodes in your mesh network (e.g. Pi 5 edge, workstation with discrete GPU).'
  },
  {
    titleDe: 'Intelligentes Kontext- & Prompt-Caching',
    titleEn: 'Intelligent Context & Prompt Caching',
    descDe: 'Erkennt wiederkehrende Systemprompts und Präfixe zur Minimierung von KV-Cache Neuberechnungen und drastischen Reduzierung der Time-to-First-Token.',
    descEn: 'Identifies recurring system prompts and prefixes to reuse KV caches, dramatically slashing time-to-first-token latencies.'
  },
  {
    titleDe: 'Ausfallresistente Fallback-Kaskaden',
    titleEn: 'Resilient Failure Fallback Cascades',
    descDe: 'Fällt ein primäres Modell oder ein Knoten aus, schaltet der Router nahtlos auf ein passendes Fallback-Modell um.',
    descEn: 'If a primary model or node becomes unavailable, the fleet router seamlessly cascades to a defined fallback model.'
  }
];

const stats = [
  { val: '0 OOMs', labelDe: 'Kernel-Kills', labelEn: 'Kernel OOMs' },
  { val: '< 10 ms', labelDe: 'Routing-Overhead', labelEn: 'Routing overhead' },
  { val: 'Mesh', labelDe: 'Netzwerkstruktur', labelEn: 'Network topology' },
  { val: 'OpenAI v1', labelDe: 'API-Kompatibel', labelEn: 'API compatibility' }
];

const latestDownloads = [
  {
    os: 'linux' as const,
    labelDe: 'Linux x86_64 (Tarball)',
    labelEn: 'Linux x86_64 (Tarball)',
    url: 'https://pi5.darter-basking.ts.net/gitea/ollama-fleet-manager/ollama-fleet-manager/releases/download/v1.0/ollama-fleet-manager-v1.0-linux.tar.gz',
    filename: 'ollama-fleet-manager-v1.0-linux.tar.gz'
  },
  {
    os: 'windows' as const,
    labelDe: 'Windows x64 (ZIP)',
    labelEn: 'Windows x64 (ZIP)',
    url: 'https://pi5.darter-basking.ts.net/gitea/ollama-fleet-manager/ollama-fleet-manager/releases/download/v1.0/ollama-fleet-manager-v1.0-windows.zip',
    filename: 'ollama-fleet-manager-v1.0-windows.zip'
  }
];

const techPills = ['Go 1.22', 'Ollama API', 'Prometheus Metrics', 'Tailscale WireGuard', 'Linux'];
---

<ProjectPage
  id="ollama-fleet-manager"
  name="ollama-fleet-manager"
  version="v1.0"
  taglineDe="Intelligenter KI-Modell-Router & OOM-Schutz für Ollama"
  taglineEn="Intelligent LLM model router & OOM protection for Ollama"
  summaryDe="Der intelligente Flotten-Manager für verteilte Ollama-Instanzen. Bietet zuverlässigen VRAM-Schutz gegen Speicherüberläufe, automatische Lastverteilung und ausfallsichere API-Weiterleitung."
  summaryEn="The intelligent fleet coordinator for distributed Ollama deployments. Features proactive VRAM memory protection against kernel crashes, automated load distribution, and resilient API routing."
  badge="Infrastructure & AI"
  icon="/assets/jb-logo.png"
  techPills={techPills}
  stats={stats}
  features={features}
  quickInstall={{ label: "Go Install", cmd: "go install pi5.darter-basking.ts.net/gitea/ollama-fleet-manager/ollama-fleet-manager@latest" }}
  giteaUrl="https://pi5.darter-basking.ts.net/gitea/ollama-fleet-manager/ollama-fleet-manager"
  latestDownloads={latestDownloads}
  downloadUrl="https://pi5.darter-basking.ts.net/gitea/ollama-fleet-manager/ollama-fleet-manager/releases/tag/v1.0"
  wikiUrl="/ollama-fleet-manager/wiki/"
/>
