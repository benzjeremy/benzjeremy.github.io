---
import ProjectPage from '../../components/ProjectPage.astro';

const features = [
  {
    titleDe: 'Clientseitige Ver- und Entschlüsselung',
    titleEn: 'Client-Side Encryption & Decryption',
    descDe: 'Kryptografische Operationen finden ausschließlich auf Ihrem Gerät statt. Das Master-Passwort verlässt niemals Ihren Rechner.',
    descEn: 'Cryptographic operations take place exclusively on your local machine. Your master password never leaves your device.'
  },
  {
    titleDe: 'Automatischer Hintergrund-Sync',
    titleEn: 'Automatic Background Sync',
    descDe: 'Erkennt Dateiänderungen in Echtzeit und synchronisiert Modifikationen verschlüsselt und bandbreiteneffizient im Hintergrund.',
    descEn: 'Detects file system modifications in real-time and synchronizes encrypted diffs efficiently in the background.'
  },
  {
    titleDe: 'Kommandozeilen-CLI & Desktop-Tray',
    titleEn: 'Command-Line CLI & Desktop Tray',
    descDe: 'Flexible Steuerung für Entwickler per Terminal-Befehl oder diskretes Tray-Icon in der GNOME/KDE-Statusleiste.',
    descEn: 'Flexible control for engineers via terminal CLI or discreet system tray status icons in GNOME and KDE.'
  },
  {
    titleDe: 'Cross-Plattform (Linux, Windows, Android)',
    titleEn: 'Cross-Platform (Linux, Windows, Android)',
    descDe: 'Einheitliche Codebasis in Go sorgt für identisches Sicherheits- und Leistungsverhalten auf Desktops und Smartphones.',
    descEn: 'Unified Go codebase delivers identical security standards and performance profiles across desktops and mobile devices.'
  }
];

const stats = [
  { val: '< 20 ms', labelDe: 'Sync-Latenz', labelEn: 'Sync latency' },
  { val: 'AES-256', labelDe: 'Client-Tresor', labelEn: 'Client vault' },
  { val: 'CLI + Tray', labelDe: 'Schnittstelle', labelEn: 'Interface' },
  { val: '100%', labelDe: 'Open-Source', labelEn: 'Open-source' }
];

const techPills = ['Go 1.22', 'AES-256-GCM', 'Inotify', 'FUSE Mount', 'Tailscale', 'Linux', 'Windows'];
---

<ProjectPage
  id="benzcloud-client"
  name="benzcloud-client"
  version="v1.0"
  taglineDe="Desktop & Mobile Mesh-Cockpit für BenzCloud"
  taglineEn="Desktop & mobile mesh cockpit for BenzCloud"
  summaryDe="Der native Client für die sichere, Ende-zu-Ende verschlüsselte BenzCloud. Bietet lokalen Dateisystem-Sync, automatische Verschlüsselung und unkomplizierte Anbindung über Tailscale."
  summaryEn="The native client companion for encrypted BenzCloud storage. Provides local file system synchronization, client-side encryption, and effortless Tailscale mesh connectivity."
  badge="Desktop & CLI"
  icon="/assets/jb-logo.png"
  techPills={techPills}
  stats={stats}
  features={features}
  quickInstall={{ label: "Go Install", cmd: "go install github.com/benzjeremy/benzcloud-client@latest" }}
  wikiUrl="/benzcloud-client/wiki/"
/>
