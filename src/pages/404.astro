---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  titleDe="404 — Seite nicht gefunden · Jeremy Benz"
  titleEn="404 — Page Not Found · Jeremy Benz"
  currentPath="/404"
>
  <div class="container">
    <div class="error-wrapper">
      <div class="error-code">404</div>
      
      <p class="eyebrow">
        <span data-lang="de">Ressource nicht auffindbar</span>
        <span data-lang="en">Resource Not Found</span>
      </p>

      <h1>
        <span data-lang="de">Hier geht’s nicht weiter.</span>
        <span data-lang="en">This page is missing.</span>
      </h1>

      <p class="lead error-desc">
        <span data-lang="de">Die angeforderte Seite existiert nicht auf diesem Server oder wurde im Zuge der Architektur-Aktualisierung verschoben.</span>
        <span data-lang="en">The requested page does not exist on this server or has been relocated during the architecture update.</span>
      </p>

      <div class="error-actions">
        <a href="/" class="button primary">
          <span data-lang="de">Zur Startseite</span>
          <span data-lang="en">Back to Home</span>
          <span aria-hidden="true">→</span>
        </a>
        <a href="/status" class="button secondary">
          <span data-lang="de">Projektkatalog ansehen</span>
          <span data-lang="en">Browse projects</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .error-wrapper {
    min-height: 55vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: clamp(48px, 8vw, 80px) 16px;
  }

  .error-code {
    font-family: var(--font-mono);
    font-size: clamp(5.5rem, 14vw, 8.5rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.06em;
    color: var(--accent);
    margin-bottom: 12px;
  }

  h1 {
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 800;
    letter-spacing: -0.035em;
    margin-block: 8px 16px;
  }

  .error-desc {
    max-width: 54ch;
    margin: 0 auto 36px;
    color: var(--text-muted);
    font-size: 1.1rem;
    line-height: 1.65;
  }

  .error-actions {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
