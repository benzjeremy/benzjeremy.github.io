    descEn: 'Lightweight, lightning-fast timetable client for WebUntis. Built with Go and native webview shells (WebKitGTK on Linux, WebView2 on Windows) – zero Electron bloat.',
    giteaRepo: 'https://pi5.darter-basking.ts.net/gitea/untis-go/untis-go',
    giteaReleases: 'https://pi5.darter-basking.ts.net/gitea/untis-go/untis-go/releases',
    downloads: [
      {
        platform: 'Linux (x86_64)',
        format: '.tar.gz',
        size: '9.4 MB',
        url: 'https://pi5.darter-basking.ts.net/gitea/untis-go/untis-go/releases/download/v2.3/untis-go-v2.3-linux.tar.gz'
      },
      {
        platform: 'Windows (x86_64)',
        format: '.zip',
        size: '10.8 MB',
        url: 'https://pi5.darter-basking.ts.net/gitea/untis-go/untis-go/releases/download/v2.3/untis-go-v2.3-windows.zip'
      }
    ]
  },
  {
    id: 'docklite',
    name: 'docklite',
    version: 'v1.2.1',
    icon: '/assets/jb-logo.png',
    descDe: 'Minimalistische, ressourcenschonende Desktop-GUI für Docker Container. Echtzeit-Metriken, Log-Stream und Container-Verwaltung mit unter 30 MB RAM-Bedarf.',
    descEn: 'Minimalist, resource-efficient desktop GUI for Docker containers. Real-time metrics, log streaming, and container lifecycle management with under 30 MB RAM.',
    giteaRepo: 'https://pi5.darter-basking.ts.net/gitea/docklite/docklite',
    giteaReleases: 'https://pi5.darter-basking.ts.net/gitea/docklite/docklite/releases',
    downloads: [
      {
        platform: 'Linux (x86_64)',
        format: '.tar.gz',
        size: '3.1 MB',
        url: 'https://pi5.darter-basking.ts.net/gitea/docklite/docklite/releases/download/v1.2.1/docklite-v1.2.1-linux-amd64.tar.gz'
      },
      {
        platform: 'Windows (x86_64)',
        format: '.zip',
        size: '3.3 MB',
        url: 'https://pi5.darter-basking.ts.net/gitea/docklite/docklite/releases/download/v1.2.1/docklite-v1.2.1-windows-amd64.zip'
      }
    ]
  },
  {
    id: 'spotify-screensaver',
    name: 'spotify-screensaver',
    version: 'v1.4',
    icon: '/assets/jb-logo.png',
    descDe: 'Vollbild-Bildschirmschoner und Medienanzeige für Spotify. Zeigt hochauflösende Album-Cover, animierte Visualisierungen und lokale Mediensteuerung.',
    descEn: 'Fullscreen screensaver and media display for Spotify. Features high-res album art, animated visualizers, and local playback controls.',
    giteaRepo: 'https://pi5.darter-basking.ts.net/gitea/spotify-screensaver/spotify-screensaver',
    giteaReleases: 'https://pi5.darter-basking.ts.net/gitea/spotify-screensaver/spotify-screensaver/releases',
    downloads: [
      {
        platform: 'Linux (x86_64)',
        format: '.tar.gz',
        size: '3.1 MB',
        url: 'https://pi5.darter-basking.ts.net/gitea/spotify-screensaver/spotify-screensaver/releases/download/v1.4/spotify-screensaver-v1.4-linux.tar.gz'
      },
      {
        platform: 'Windows (x86_64)',
        format: '.zip',
        size: '3.2 MB',
        url: 'https://pi5.darter-basking.ts.net/gitea/spotify-screensaver/spotify-screensaver/releases/download/v1.4/spotify-screensaver-v1.4-windows.zip'
      }
    ]
  },
  {
    id: 'ollama-fleet-manager',
    name: 'ollama-fleet-manager',
    version: 'v1.0',
    icon: '/assets/jb-logo.png',
    descDe: 'Verteiltes Management für mehrere Ollama-Instanzen. Automatische Lastverteilung, Modell-Synchronisation und aggregiertes Monitoring über Tailscale.',
    descEn: 'Distributed management for multiple Ollama instances. Automatic load balancing, model synchronization, and aggregated monitoring across Tailscale.',
    giteaRepo: 'https://pi5.darter-basking.ts.net/gitea/ollama-fleet-manager/ollama-fleet-manager',
    giteaReleases: 'https://pi5.darter-basking.ts.net/gitea/ollama-fleet-manager/ollama-fleet-manager/releases',
    downloads: [
      {
        platform: 'Linux (x86_64)',
        format: '.tar.gz',
        size: '3.0 MB',
        url: 'https://pi5.darter-basking.ts.net/gitea/ollama-fleet-manager/ollama-fleet-manager/releases/download/v1.0/ollama-fleet-manager-v1.0-linux.tar.gz'
      },
      {
        platform: 'Windows (x86_64)',
        format: '.zip',
        size: '3.1 MB',
        url: 'https://pi5.darter-basking.ts.net/gitea/ollama-fleet-manager/ollama-fleet-manager/releases/download/v1.0/ollama-fleet-manager-v1.0-windows.zip'
      }
