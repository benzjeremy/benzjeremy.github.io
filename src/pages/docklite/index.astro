---
import ProjectPage from '../../components/ProjectPage.astro';

const features = [
  {
    titleDe: 'Schlank & Effizient ohne Node.js-Overhead',
    titleEn: 'Lightweight & Fast without Node.js Bloat',
    descDe: 'Kompiliert zu einem einzigen nativen Go-Binary mit eingebettetem Astro-Dashboard. Benötigt unter 18 MB RAM und startet in Millisekunden.',
    descEn: 'Compiled into a single native Go binary with embedded Astro dashboard. Consumes under 18 MB of RAM and boots in milliseconds.'
  },
  {
    titleDe: 'Duale Oberfläche: TUI & Web-Cockpit',
    titleEn: 'Dual UI: BubbleTea TUI & Web Cockpit',
    descDe: 'Verwalten Sie Container direkt auf der Kommandozeile mit der reaktiven BubbleTea TUI oder über das moderne Web-Dashboard im Browser.',
    descEn: 'Manage containers straight from your terminal using the reactive BubbleTea TUI or through the clean modern web dashboard.'
  },
  {
    titleDe: 'Echtzeit-Metriken & Log-Streaming',
    titleEn: 'Real-Time Metrics & Log Streaming',
    descDe: 'CPU-, Memory- und I/O-Auslastung live im Blick. ANSI-Farbtreues Log-Streaming über WebSockets ohne Browser-Verzögerung.',
    descEn: 'Monitor live CPU, memory, and I/O utilization. Stream ANSI-colored container logs via WebSockets with zero browser lag.'
  },
  {
    titleDe: 'Lokale SQLite-Aktionsprotokollierung',
    titleEn: 'Local SQLite Action Auditing',
    descDe: 'Jeder Container-Start, Stop oder Restart wird nachvollziehbar in einer lokalen SQLite-Datenbank protokolliert – 100% datenschutzkonform.',
    descEn: 'Every container start, stop, or restart action is logged in a local SQLite audit database – 100% privacy-preserving.'
  }
];

const stats = [
  { val: '< 18 MB', labelDe: 'RAM-Bedarf', labelEn: 'Memory usage' },
  { val: '< 5 ms', labelDe: 'API-Latenz', labelEn: 'API latency' },
  { val: '100%', labelDe: 'Local-First', labelEn: 'Local-first' },
  { val: 'TUI + Web', labelDe: 'Oberfläche', labelEn: 'Interface' }
];

const latestDownloads = [
  {
    os: 'linux' as const,
    labelDe: 'Linux x86_64 (Tarball)',
    labelEn: 'Linux x86_64 (Tarball)',
    url: 'https://pi5.darter-basking.ts.net/gitea/docklite/docklite/releases/download/v1.2.1/docklite-v1.2.1-linux-amd64.tar.gz',
    filename: 'docklite-v1.2.1-linux-amd64.tar.gz'
  },
  {
    os: 'windows' as const,
    labelDe: 'Windows x64 (ZIP)',
    labelEn: 'Windows x64 (ZIP)',
    url: 'https://pi5.darter-basking.ts.net/gitea/docklite/docklite/releases/download/v1.2.1/docklite-v1.2.1-windows-amd64.zip',
    filename: 'docklite-v1.2.1-windows-amd64.zip'
  }
];

const techPills = ['Go 1.22', 'Docker Engine API', 'BubbleTea', 'Astro', 'SQLite', 'WebSockets', 'Linux'];
---

<ProjectPage
  id="docklite"
  name="docklite"
  version="v1.3"
  taglineDe="Schlanke Portainer-Alternative in Go & Astro"
  taglineEn="Lightweight Portainer alternative in Go & Astro"
  summaryDe="Das ressourcenschonende Kontrollzentrum für Docker-Container auf Linux- und Homelab-Systemen. Intuitive Verwaltung über Terminal-UI (BubbleTea) und Web-Dashboard ohne Cloud-Zwang oder Telemetrie."
  summaryEn="The lightweight management cockpit for Docker containers on Linux and homelab systems. Seamlessly control containers via terminal UI (BubbleTea) or web dashboard with zero cloud dependency and zero telemetry."
  badge="Desktop & Server"
  icon="/assets/docklite.svg"
  techPills={techPills}
  stats={stats}
  features={features}
  quickInstall={{ label: "Go Install", cmd: "go install pi5.darter-basking.ts.net/gitea/docklite/docklite@latest" }}
  giteaUrl="https://pi5.darter-basking.ts.net/gitea/docklite/docklite"
  latestDownloads={latestDownloads}
  downloadUrl="https://pi5.darter-basking.ts.net/gitea/docklite/docklite"
  wikiUrl="/docklite/wiki/"
/>
