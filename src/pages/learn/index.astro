---
import ProjectPage from '../../components/ProjectPage.astro';

const features = [
  {
    titleDe: 'Interaktiver Code-Playground im Browser',
    titleEn: 'Interactive In-Browser Code Playground',
    descDe: 'Üben Sie Go, HTML5, modernes CSS und Bash direkt im Browser mit sofortiger Syntaxprüfung und isolierter Ausführung über Web Worker.',
    descEn: 'Practice Go, HTML5, modern CSS, and Bash directly inside your browser with real-time syntax checking and isolated Web Worker execution.'
  },
  {
    titleDe: '90-Minuten-Abschlussprüfungen nach Prüfungsstandard',
    titleEn: '90-Minute Timed Mock Exams',
    descDe: 'Realitätsnahe Prüfungssimulationen mit Multiple-Choice, praktischen Programmieraufgaben und automatischer Leistungsanalyse.',
    descEn: 'Realistic exam simulations featuring multiple-choice questions, live coding challenges, and automated score evaluations.'
  },
  {
    titleDe: 'Kompakte Cheatsheets & Architektur-Guides',
    titleEn: 'Condensed Cheatsheets & Architecture Guides',
    descDe: 'Prägnante Referenzen zu Go-Goroutinen, WebKitGTK-Bindings, AES-Kryptografie, Docker-Containern und barrierefreiem UI-Design.',
    descEn: 'Succinct references covering Go concurrency, WebKitGTK bindings, AES cryptography, Docker containers, and accessible UI design.'
  },
  {
    titleDe: '100% Lokaler Lernfortschritt',
    titleEn: '100% Local Learning Progress',
    descDe: 'Lesezeichen, Prüfungsnoten und bearbeitete Lektionen werden ausschließlich in Ihrem lokalen Browser gespeichert – keine Cloud-Registrierung.',
    descEn: 'Bookmarks, test scores, and completed lessons are stored strictly inside your browser – zero cloud account requirements.'
  }
];

const stats = [
  { val: '8 Tracks', labelDe: 'Themengebiete', labelEn: 'Learning tracks' },
  { val: '150+', labelDe: 'Prüfungsfragen', labelEn: 'Exam questions' },
  { val: 'Local-First', labelDe: 'Datenschutz', labelEn: 'Privacy model' },
  { val: 'Web Worker', labelDe: 'Code-Ausführung', labelEn: 'Code execution' }
];

const techPills = ['Astro', 'TypeScript', 'Web Workers', 'PrismJS', 'IndexedDB', 'HTML5', 'Go'];
---

<ProjectPage
  id="learn"
  name="learn"
  version="v2.0"
  taglineDe="Interaktive Lernplattform für Go, Web & Cybersecurity"
  taglineEn="Interactive learning platform for Go, Web & Cybersecurity"
  summaryDe="Die praxisnahe Open-Source Lern- und Prüfungsumgebung für moderne Softwareentwicklung. Bietet interaktive Coding-Playgrounds, kompakte Cheat Sheets und anspruchsvolle 90-Minuten-Abschlussprüfungen."
  summaryEn="The hands-on open source learning and examination environment for modern software development. Features interactive in-browser playgrounds, cheat sheets, and timed 90-minute graduation exams."
  badge="Web & Education"
  icon="/assets/learn.png"
  techPills={techPills}
  stats={stats}
  features={features}
  appUrl="/learn/app/"
  wikiUrl="/learn/wiki/"
/>
