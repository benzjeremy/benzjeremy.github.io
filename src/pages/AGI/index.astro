---
import ProjectPage from '../../components/ProjectPage.astro';

const features = [
  {
    titleDe: 'SEAN-Architektur (Self-Evolving Autonomous Network)',
    titleEn: 'SEAN Architecture (Self-Evolving Autonomous Network)',
    descDe: 'Erforschung synergetischer Agenten-Netzwerke mit hierarchischer Aufgabenteilung, dynamischem Tool-Discovery und reflexiven Selbstverbesserungsschleifen.',
    descEn: 'Research into synergistic agent networks with hierarchical division of labor, dynamic tool discovery, and reflexive self-improvement loops.'
  },
  {
    titleDe: 'Hierarchisches Second-Brain Gedächtnismodell',
    titleEn: 'Hierarchical Second Brain Memory Model',
    descDe: 'Strikte 4-stufige Wissensorganisation über den Obsidian Graph. Trennung von episodischem Aktionsprotokoll, deklarativen Standards und Wissens-Hubs.',
    descEn: 'Strict 4-tier knowledge organization across the Obsidian Graph. Clean separation between episodic action logs, declarative standards, and project hubs.'
  },
  {
    titleDe: 'Empirische Benchmark-Suite gegen KI-Halluzinationen',
    titleEn: 'Empirical Benchmark Suite against Hallucinations',
    descDe: 'Validiert Agentenentscheidungen durch zwingende Terminal-Verifikation (Compiler-Exit-Codes, Unit-Tests, kryptografische Hash-Prüfungen).',
    descEn: 'Validates agent assertions via mandatory terminal execution (compiler exit codes, unit tests, cryptographic hash verifications).'
  },
  {
    titleDe: 'Zero-Dummy-Security als fundamentale Forschungsrichtlinie',
    titleEn: 'Zero-Dummy-Security as Core Research Directive',
    descDe: 'Untersucht die Eliminierung von Mock-Code und Scheinsicherheit in KI-generierten Systemen durch strikte formale Richtlinien und Guardrails.',
    descEn: 'Investigates the systematic elimination of mock code and fake security in LLM synthesis through formal invariants and verifiable standards.'
  }
];

const stats = [
  { val: 'SEAN v2', labelDe: 'Forschungsrahmen', labelEn: 'Research framework' },
  { val: 'Exit 0', labelDe: 'Verifikationsstandard', labelEn: 'Verification standard' },
  { val: '4 Stufen', labelDe: 'Mindmap-Hierarchie', labelEn: 'Graph hierarchy' },
  { val: '100%', labelDe: 'Reproduzierbarkeit', labelEn: 'Reproducibility' }
];

const techPills = ['Python 3.12', 'Go', 'Obsidian Graph', 'Autonomous Loops', 'Formal Verification', 'Zero-Dummy-Security'];
---

<ProjectPage
  id="AGI"
  name="AGI"
  version="v2.0"
  taglineDe="Functional AGI Research · Benchmark-Suite & SEAN Architektur"
  taglineEn="Functional AGI research · benchmark suite & SEAN architecture"
  summaryDe="Das wissenschaftliche Forschungsprojekt zur Realisierung funktionaler, verifizierbarer und sicherer autonomer KI-Agenten. Basiert auf der SEAN-Architektur, Second-Brain Wissensgraphen und strengen Null-Fehlertoleranz-Standards."
  summaryEn="The scientific research initiative towards functional, verifiable, and safe autonomous AI agents. Grounded in SEAN architecture, Second Brain knowledge graphs, and zero-tolerance verification standards."
  badge="Research & AI"
  icon="/assets/jb-logo.png"
  techPills={techPills}
  stats={stats}
  features={features}
  wikiUrl="/AGI/wiki/"
/>
