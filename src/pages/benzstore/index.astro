---
import ProjectPage from '../../components/ProjectPage.astro';

const features = [
  {
    titleDe: 'Kuratierter Softwarekatalog & Direktdownload',
    titleEn: 'Curated Software Directory & Direct Downloads',
    descDe: 'Alle Anwendungen aus dem Jeremy Benz Ökosystem auf einen Blick – verifiziert, ohne Drittanbieter-Werbung und ohne Registrierungszwang.',
    descEn: 'All applications across the Jeremy Benz ecosystem in one spot – verified, ad-free, and accessible without account requirements.'
  },
  {
    titleDe: 'Kryptografische Signaturprüfung (SHA-256)',
    titleEn: 'Cryptographic Integrity Verification (SHA-256)',
    descDe: 'Jedes Paket und jedes APK verfügt über transparente SHA-256 Prüfsummen und Build-Attestierungen für maximale Sicherheit.',
    descEn: 'Every binary package and APK features verified SHA-256 checksums and build attestations for maximum trust.'
  },
  {
    titleDe: 'F-Droid Repository Synchronisation',
    titleEn: 'F-Droid Repository Synchronization',
    descDe: 'Nahtlose Anbindung an das offizielle F-Droid Repository (`myfdroid`). Updates werden automatisch bereitgestellt und signiert.',
    descEn: 'Seamless integration with the official F-Droid repository (`myfdroid`). Updates are automatically published and signed.'
  },
  {
    titleDe: 'Offline-First Web-App & PWA',
    titleEn: 'Offline-First Web App & PWA',
    descDe: 'Installierbar auf Smartphones und Desktop-PCs als Progressive Web App mit vollständiger Offline-Katalognavigation.',
    descEn: 'Installable on mobile devices and desktop computers as a Progressive Web App with full offline browsing.'
  }
];

const stats = [
  { val: '12+', labelDe: 'Apps & Tools', labelEn: 'Apps & tools' },
  { val: '0%', labelDe: 'Tracking & Werbung', labelEn: 'Tracking & ads' },
  { val: 'SHA-256', labelDe: 'Integritätsprüfung', labelEn: 'Integrity check' },
  { val: 'PWA', labelDe: 'Web & Mobile', labelEn: 'Web & mobile' }
];

const techPills = ['Vanilla JS', 'F-Droid V2 Index', 'PWA', 'Android APK', 'Linux AppImage', 'Web API'];
---

<ProjectPage
  id="benzstore"
  name="benzstore"
  version="v1.1"
  taglineDe="Unified Privacy-First AppStore for Android & PC"
  taglineEn="Unified Privacy-First AppStore for Android & PC"
  summaryDe="Das zentrale Portal für verifizierte, datenschutzfreundliche Open-Source-Software für Android und Desktop. Bietet transparente Downloads, F-Droid Repository Anbindung und kryptografische Integritätsprüfungen."
  summaryEn="The central portal for verified, privacy-focused open source software across Android and PC. Offers transparent downloads, F-Droid repository synchronization, and cryptographic integrity verification."
  badge="Web & Android"
  icon="/assets/benzstore.png"
  techPills={techPills}
  stats={stats}
  features={features}
  appUrl="/benzstore/app/"
  wikiUrl="/benzstore/wiki/"
/>
