---
import ProjectPage from '../../components/ProjectPage.astro';

const features = [
  {
    titleDe: 'Intelligente E-Mail & Notification Triage',
    titleEn: 'Intelligent Email & Notification Triage',
    descDe: 'Verbindet sich mit Proton Mail über CLI-Tools. Filtert Newsletter und Automaten-Mails geräuschlos heraus; leitet nur handlungsrelevante Nachrichten weiter.',
    descEn: 'Connects to Proton Mail via CLI tooling. Silently drops marketing noise; prioritizes and forwards only actionable messages from real humans.'
  },
  {
    titleDe: 'WhatsApp & Matrix Echtzeit-Gateway',
    titleEn: 'WhatsApp & Matrix Real-Time Gateway',
    descDe: 'Ermöglicht bidirektionale Kommunikation mit J.A.R.V.I.S. über WhatsApp (Chat, Sprachnotizen, Push-Alarme) und dezentrale Matrix-Räume.',
    descEn: 'Enables bidirectional interaction with J.A.R.V.I.S. over WhatsApp (chat, voice memos, push alerts) and decentralized Matrix rooms.'
  },
  {
    titleDe: 'Zentraler Event- & Systemalarm-Broker',
    titleEn: 'Central Event & System Alarm Broker',
    descDe: 'Nimmt Systemd-Statusmeldungen, Backup-Ergebnisse und Sicherheitswarnungen entgegen und verteilt sie nach konfigurierbaren Eskalationsstufen.',
    descEn: 'Consumes systemd events, backup audit outcomes, and security notices, routing them across configurable escalation pipelines.'
  },
  {
    titleDe: 'Lokale SQLite-Aktionshistorie & Zero-Telemetry',
    titleEn: 'Local SQLite Event Store & Zero Telemetry',
    descDe: 'Alle ausgetauschten Ereignisse verbleiben in der lokalen SQLite-Instanz. Keine Metadatenübertragung an externe Analytics-Dienste.',
    descEn: 'All routed events and telemetry remain stored in the local SQLite audit log. Zero telemetry transmitted to third-party brokers.'
  }
];

const stats = [
  { val: '< 20 ms', labelDe: 'Event-Latenz', labelEn: 'Event latency' },
  { val: '99.8%', labelDe: 'Filtergenauigkeit', labelEn: 'Filtering accuracy' },
  { val: 'Local-First', labelDe: 'Architektur', labelEn: 'Architecture' },
  { val: 'E2EE', labelDe: 'Transportverschlüsselung', labelEn: 'Transport security' }
];

const techPills = ['Go 1.22', 'WebSockets', 'SQLite', 'Proton-CLI', 'WhatsApp Bridge', 'Matrix API', 'Systemd'];
---

<ProjectPage
  id="omnichannel-hub"
  name="omnichannel-hub"
  version="v1.1"
  taglineDe="Unified Messaging Hub & Real-Time Broker"
  taglineEn="Unified messaging hub & real-time broker"
  summaryDe="Die zentrale Kommunikationszentrale für Benachrichtigungen, E-Mail-Triage und Multi-Kanal-Meldungen. Verbindet WhatsApp, Proton Mail, Matrix und Systemdienste zu einem einheitlichen, rauschfreien Informationsstrom."
  summaryEn="The unified communication nexus for notifications, email triage, and multi-channel events. Integrates WhatsApp, Proton Mail, Matrix, and system services into a prioritized, noise-free stream."
  badge="Messaging & Automation"
  icon="/assets/jb-logo.png"
  techPills={techPills}
  stats={stats}
  features={features}
  quickInstall={{ label: "Go Install", cmd: "go install github.com/benzjeremy/omnichannel-hub@latest" }}
  wikiUrl="/omnichannel-hub/wiki/"
/>
